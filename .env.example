# LLM — cambiar solo esta línea para cambiar de modelo
# Gemini (más estable, recomendado):
LLM_MODEL=gemini/gemini-2.5-flash
GEMINI_API_KEY=

# Groq (más rápido pero con rate limits):
# LLM_MODEL=groq/llama-3.3-70b-versatile
GROQ_API_KEY=

# Anthropic:
# LLM_MODEL=anthropic/claude-sonnet-4-5
ANTHROPIC_API_KEY=

# Supabase — Settings → API en el dashboard
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Meta Ads
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_...
META_PAGE_ID=
META_USE_SANDBOX=true

# TikTok Ads (multichannel core — single-tenant, leído por EnvCredentialResolver)
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_USE_SANDBOX=false

# Google Ads (multichannel core — single-tenant, leído por EnvCredentialResolver)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# App
ENVIRONMENT=sandbox
PORT=8000
VITE_BACKEND_URL=http://localhost:8000

# Security
# API key that the frontend must send in X-API-Key header on every LLM-touching endpoint.
# Generate with: openssl rand -hex 32
ADKIO_API_KEY=

# Comma-separated list of allowed CORS origins.
# In production set this to your Vercel URL: https://adkio.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# LLM token caps (optional — defaults shown)
MAX_TOKENS_CAMPAIGN=2000
MAX_TOKENS_ONBOARDING=500

# ── Multitenant auth ───────────────────────────────────────────────────────
# Generar con: openssl rand -hex 32  (o python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=

# Cifrado de tokens de plataforma. Generar con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PLATFORM_TOKENS_ENC_KEY=

# Modo estricto: si true, todo endpoint no público requiere JWT válido.
# Default false durante la transición de single-tenant → multitenant.
ADKIO_REQUIRE_AUTH=false

# ── OAuth providers (T6) ───────────────────────────────────────────────────
# Meta — reusa META_APP_ID/META_APP_SECRET
META_OAUTH_REDIRECT_URI=http://localhost:8000/connect/meta/callback

# TikTok
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_OAUTH_REDIRECT_URI=http://localhost:8000/connect/tiktok/callback

# Google Ads
ADKIO_GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/connect/google_ads/callback

# Frontend redirect después de OAuth callback
FRONTEND_AFTER_OAUTH_URL=http://localhost:5173/settings
