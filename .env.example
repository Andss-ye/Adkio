# LLM — cambiar solo esta línea para cambiar de modelo
LLM_MODEL=groq/llama-3.3-70b-versatile

# Groq (default, gratis)
GROQ_API_KEY=

# Gemini (alternativa gratuita)
GEMINI_API_KEY=

# Anthropic (cuando lleguen créditos)
ANTHROPIC_API_KEY=sk-ant-...

# Supabase
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Meta / Facebook Ads API
META_APP_ID=your_app_id_here
META_APP_SECRET=your_app_secret_here
META_ACCESS_TOKEN=EAF...your_token_here
META_AD_ACCOUNT_ID=act_your_ad_account_id
META_PAGE_ID=your_page_id_here
META_USE_SANDBOX=true

# Cloudinary (Objetivo C — para uploads de imágenes de anuncios)
CLOUDINARY_CLOUD_NAME=...
CLOUDINARY_API_KEY=...
CLOUDINARY_API_SECRET=...

# App
ENVIRONMENT=sandbox
MAX_BUDGET_USD=200

# Frontend
VITE_BACKEND_URL=http://localhost:8000
