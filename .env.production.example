# ════════════════════════════════════════════════════════════════════════════
# Adkio · Variables de entorno para PRODUCCIÓN (Railway)
# ════════════════════════════════════════════════════════════════════════════
# Hay DOS servicios en Railway. Cada bloque va en el servicio que corresponde.
# Reemplazá los <PLACEHOLDER> con los valores reales (los secretos están en tu
# .env local — NO los pongas en este archivo, que va al repo).
#
# URLs del deploy actual:
#   Backend : https://adkio-production.up.railway.app
#   Frontend: https://stunning-gentleness-production.up.railway.app
# ════════════════════════════════════════════════════════════════════════════


# ┌──────────────────────────────────────────────────────────────────────────┐
# │ SERVICIO BACKEND  (adkio-production)                                       │
# └──────────────────────────────────────────────────────────────────────────┘

# ── REQUERIDAS — sin estas el backend arranca pero /auth/signup y /campaign dan 500 ──

# LLM (vía litellm). Para el pitch usamos Claude Sonnet 4.5.
LLM_MODEL=anthropic/claude-sonnet-4-5
ANTHROPIC_API_KEY=<sk-ant-...>

# Supabase (Settings → API en el dashboard). El backend usa la service_role.
SUPABASE_URL=https://aphrujuaklsytbnhcthm.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role JWT>
SUPABASE_ANON_KEY=<anon JWT>

# Auth multitenant — JWT propio. Generar: openssl rand -hex 32
#   ⚠ Si falta, /auth/signup y /auth/login devuelven 500.
JWT_SECRET=<hex de 64 chars>

# Cifrado de tokens de plataforma (platform_connections).
#   Generar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   ⚠ Si falta, guardar una API key (conectar Meta/TikTok/Google) falla.
PLATFORM_TOKENS_ENC_KEY=<fernet key base64>

# CORS — DEBE incluir el origen EXACTO del frontend (sin barra final, con https).
#   ⚠ Si falta o no coincide → el navegador bloquea todo con error de CORS.
ALLOWED_ORIGINS=https://stunning-gentleness-production.up.railway.app

# Entorno + puerto (Railway inyecta PORT solo; si no, dejalo en 8000).
ENVIRONMENT=production
PORT=8000

# ── Meta Ads (sandbox compartido para la demo — token de la cuenta del equipo) ──
META_APP_ID=1232703468750504
META_APP_SECRET=<app secret>
META_ACCESS_TOKEN=<access token de Meta>
META_AD_ACCOUNT_ID=act_269458954399128
META_PAGE_ID=1029511980255910
META_USE_SANDBOX=true

# ── OPCIONALES ───────────────────────────────────────────────────────────────

# Protección extra de endpoints LLM (header X-API-Key). Vacío = abierto (warning en logs).
#   Si lo seteás, el frontend debe mandar el mismo valor en VITE_API_KEY.
ADKIO_API_KEY=

# Modo auth estricto: si true, todo endpoint no público exige JWT. Dejar en false
# permite la demo sin login (cae a la marca demo-edu-latam y al sandbox).
ADKIO_REQUIRE_AUTH=false

# Topes de tokens del LLM (defaults mostrados).
MAX_TOKENS_CAMPAIGN=2000
MAX_TOKENS_ONBOARDING=500
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=30

# ── OAuth de plataformas (opcional — hoy NO habilitado) ──────────────────────
# Meta OAuth requiere la app en modo Live (App Review en el panel de Meta). Mientras
# tanto se usa "API key manual" en Settings. TikTok/Google: sin estas vars, el botón
# Conectar avisa de usar API key manual (no rompe).
META_OAUTH_REDIRECT_URI=https://adkio-production.up.railway.app/connect/meta/callback
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_OAUTH_REDIRECT_URI=https://adkio-production.up.railway.app/connect/tiktok/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://adkio-production.up.railway.app/connect/google_ads/callback
FRONTEND_AFTER_OAUTH_URL=https://stunning-gentleness-production.up.railway.app/dashboard?panel=settings

# ── TikTok / Google Ads single-tenant (opcional — EnvCredentialResolver) ─────
# Solo si querés un sandbox global de estas plataformas. Sin esto, las campañas
# de TikTok/Google caen a mock (PAUSED, no gasta).
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
TIKTOK_USE_SANDBOX=false
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=


# ┌──────────────────────────────────────────────────────────────────────────┐
# │ SERVICIO FRONTEND  (stunning-gentleness-production)                        │
# └──────────────────────────────────────────────────────────────────────────┘
# Vite inyecta estas en build-time (deben existir ANTES de buildear el front).

# URL del backend desplegado (sin barra final).
VITE_BACKEND_URL=https://adkio-production.up.railway.app

# Solo si en el backend seteaste ADKIO_API_KEY: poné el MISMO valor acá.
VITE_API_KEY=


# ════════════════════════════════════════════════════════════════════════════
# CHECKLIST RÁPIDO DE DEPLOY
# ════════════════════════════════════════════════════════════════════════════
# 1. Backend: setear todas las REQUERIDAS (sobre todo JWT_SECRET, SUPABASE_*,
#    PLATFORM_TOKENS_ENC_KEY y ALLOWED_ORIGINS) → redeploy.
# 2. Frontend: setear VITE_BACKEND_URL → rebuild (Vite las toma en build).
# 3. Migraciones Supabase 001–005: YA aplicadas en el proyecto compartido.
# 4. Si /auth/signup da 500 → mirar logs del backend: dirá qué env var falta
#    (ej "JWT_SECRET no está seteada" o "SUPABASE_URL ... deben estar en .env").
# 5. Si hay error de CORS → revisar que ALLOWED_ORIGINS sea EXACTO el origin del
#    front (https, sin barra final, sin path).
# ════════════════════════════════════════════════════════════════════════════
